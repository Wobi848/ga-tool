# Drizzle
DATABASE_URL=local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Resend (optional — enables email verification on registration)
# Get a free API key at https://resend.com (100 emails/day free)
# Without this key, email verification is disabled and users log in immediately after registration
RESEND_API_KEY=""
RESEND_FROM="GA Tool <noreply@yourdomain.com>"

# Registrierung schliessen, sobald das Portal oeffentlich erreichbar ist.
# Ohne die Variable bleibt sie offen. Ausnahme: ist noch kein Konto vorhanden,
# geht Registrierung immer — sonst sperrt sich eine frische Installation aus.
REGISTRIERUNG_OFFEN=false

# Adresse, unter der ein vorgeschalteter Tunnel (tailscale serve/funnel) den
# Dienst anspricht. Nur dann wird x-forwarded-for geglaubt; sonst koennte sich
# jeder eine Absenderadresse ausdenken und die Anmeldebremse umgehen.
VERTRAUTER_PROXY=192.168.178.2

# Einladungscode. Ist er gesetzt, darf sich registrieren, wer ihn kennt — auch
# bei REGISTRIERUNG_OFFEN=false. Damit laesst sich gezielt jemand dazunehmen,
# ohne die Tuer fuer alle zu oeffnen. Leer oder nicht gesetzt heisst: kein Weg
# hinein.
REGISTRIER_CODE=

# Anmeldepflicht fuer Zugriffe ueber die oeffentliche Adresse (tailscale
# funnel). Standard an. false macht die Inhalte oeffentlich lesbar; Objekte,
# Checklisten und der Admin-Bereich bleiben in jedem Fall hinter der Anmeldung.
OEFFENTLICH_ANMELDEPFLICHT=true
